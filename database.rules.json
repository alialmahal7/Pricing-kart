{
  "rules": {
    "users": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" },
      ".write": false
    },
    "pricing": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      "$doc": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (root.child('users').child(auth.uid).child('role').val() === 'editor' && ($doc === 'fares' || $doc === 'iata' || $doc === 'log')))"
      }
    }
  }
}
